# Optional. Nothing here is required to use the package -- the bundled
# circuits work offline and the bulk tables are public.
# Copy to .env and edit whichever lines you need.

# Where the 1.1 GB of connectome tables are kept.
# Default is the OS cache directory, which is the right answer on most
# machines:
#   Windows   %LOCALAPPDATA%\flybrain\Cache
#   macOS     ~/Library/Caches/flybrain
#   Linux     ${XDG_CACHE_HOME:-~/.cache}/flybrain
# Set this to put them on a different volume -- an external drive, or a
# partition with more room. Both slash styles work on Windows.
#FLYBRAIN_DATA_DIR=D:/fly-brain-data

# Where scripts write results. Default: ./output relative to where you run.
#FLYBRAIN_OUTPUT_DIR=output

# Only for the authenticated neuPrint query path (flybrain[neuprint]).
# Everything else reads the public bulk tables and needs no token.
# Get one at https://neuprint.janelia.org -> Account -> Auth Token
#NEUPRINT_TOKEN=paste_your_token_here
#NEUPRINT_DATASET=male-cns:v1.0

# Force a MuJoCo rendering backend. Normally leave unset: Linux picks glfw
# (or osmesa with no display), Windows and macOS use their own default.
#MUJOCO_GL=glfw
