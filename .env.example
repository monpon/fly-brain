# Get a token from https://neuprint.janelia.org -> click your account icon -> Account
NEUPRINT_TOKEN=paste_your_token_here

# Dataset to query. Run `scripts/check_env.py` to list what the server offers.
NEUPRINT_DATASET=male-cns:v1.0

# MuJoCo rendering backend. glfw works on this machine (needs a display).
# Switch to osmesa for headless once `sudo apt install libosmesa6` is done.
MUJOCO_GL=glfw

# Where the bulk connectome tables live (external volume, not the repo).
FLYBRAIN_DATA_DIR=/run/media/monpon/storage/fly-brain-data
